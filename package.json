{
  "name": "builder-stellar",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "lint": "pnpm --dir apps/web lint",
    "typecheck": "pnpm --dir apps/web typecheck",
    "contracts:build": "SOROBAN_SDK_BUILD_SYSTEM_SUPPORTS_SPEC_SHAKING_V2=0 cargo build -p token -p governor -p treasury -p auction -p manager -p metadata --release --target wasm32v1-none",
    "contracts:bindings": "node scripts/generate-bindings.mjs",
    "contracts:generate-config": "node scripts/generate-deployment-config.mjs",
    "contracts:clean": "cargo clean",
    "contracts:test:unit": "cargo test -p token -p governor -p treasury -p auction -p manager -p metadata",
    "contracts:test:e2e": "cargo test -p dao-e2e",
    "contracts:test:all": "pnpm contracts:test:unit && pnpm contracts:test:e2e",
    "indexer:generate": "pnpm --dir packages/goldsky generate",
    "indexer:test": "pnpm --dir packages/goldsky test",
    "deploy:local": "node scripts/deploy-contracts.mjs configs/local.json",
    "deploy:testnet": "node scripts/deploy-contracts.mjs configs/testnet.json",
    "local:up": "node scripts/local-up.mjs",
    "local:down": "node scripts/local-down.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/*/*"
  ],
  "devDependencies": {
    "lefthook": "^2.1.12"
  }
}
