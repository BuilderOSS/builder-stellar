# dev.tribes.build's pipeline: the dev Manager (configs/testnet-dev-manager.json), built from the
# `dev` branch, into the Neon `dev` branch of stellar-builder-testnet. Runbook: docs/DEV_DEPLOYMENT.md.
#   GOLDSKY_ENV_FILE=dev.env pnpm generate
#   GOLDSKY_ENV_FILE=dev.env ./scripts/deploy.sh deploy
# No credentials here: BUILDER_DEV_POSTGRES_SECRET is held by Goldsky (goldsky secret create).
MANAGER_DEPLOYMENT_FILE=deploys/dev-testnet-manager.json
GOLDSKY_PIPELINE_NAME=builder-stellar-testnet-dev
GOLDSKY_PIPELINE_FILE=pipelines/builder-stellar-dev-events.yaml
GOLDSKY_POSTGRES_SECRET=BUILDER_DEV_POSTGRES_SECRET
