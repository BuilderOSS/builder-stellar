# tribes.build's pipeline: the production Manager (configs/testnet-manager.json, label builder), into the
# Neon `production` branch of stellar-builder-testnet. Until release 1 this lived only in a local .env.local.
#   GOLDSKY_ENV_FILE=prod.env pnpm generate
#   GOLDSKY_ENV_FILE=prod.env ./scripts/deploy.sh deploy
# No credentials here: BUILDER_POSTGRES_SECRET is the name of a secret Goldsky holds (goldsky secret create).
MANAGER_DEPLOYMENT_FILE=deploys/builder-testnet-manager.json
GOLDSKY_PIPELINE_NAME=builder-stellar-testnet
GOLDSKY_PIPELINE_FILE=pipelines/builder-stellar-events.yaml
GOLDSKY_POSTGRES_SECRET=BUILDER_POSTGRES_SECRET
