name: {{PIPELINE_NAME}}
description: {{DESCRIPTION}}
resource_size: {{RESOURCE_SIZE}}
use_dedicated_ip: false
job: false
sources:
  stellar_events:
    type: dataset
    dataset_name: {{DATASET_NAME}}
    version: 1.2.0
    start_at: {{START_AT}}

transforms:
  dao_events:
    type: sql
    primary_key: event_id
    sql: |
      SELECT
        id AS event_id,
        '{{DEPLOYMENT_ID}}' AS deployment_id,
        contract_id,
        CASE WHEN contract_id = '{{MANAGER_CONTRACT_ID}}' THEN 'manager' ELSE 'unknown' END AS contract_role,
        type,
        topics,
        data,
        in_successful_contract_call,
        transaction_hash,
        transaction_account,
        transaction_account_muxed,
        transaction_fee_account,
        transaction_fee_account_muxed,
        transaction_successful,
        transaction_index,
        operation_body,
        operation_result_code,
        operation_type,
        ledger_sequence,
        ledger_hash,
        ledger_closed_at,
        _gs_op
      FROM stellar_events
       WHERE ledger_sequence >= {{START_AT}}

  raw_events:
    type: script
    from: dao_events
    language: typescript
    primary_key: event_id
    schema:
      event_id: string
      deployment_id: string
      contract_id: string
      contract_role: string
      topics: string
      data: string
      transaction_hash: string
      transaction_successful: boolean
      ledger_sequence: int64
      ledger_hash: string
      ledger_closed_at: string
      transaction_index: int64
      operation_index: int64
      event_index: int64
      operation_type: string
      _gs_op: string
    script: |
{{RAW_EVENTS_SCRIPT}}

  decoded_events:
    type: script
    from: raw_events
    language: typescript
    primary_key: event_id
    schema:
      event_id: string
      deployment_id: string
      contract_id: string
      contract_role: string
      event_name: string
      topic_0: string
      topic_1: string
      topic_2: string
      topic_3: string
      topics: string
      args: string
      transaction_hash: string
      transaction_successful: boolean
      ledger_sequence: int64
      ledger_hash: string
      ledger_closed_at: string
      transaction_index: int64
      operation_index: int64
      event_index: int64
      operation_type: string
      _gs_op: string
      decoder_version: string
    script: |
{{DECODED_EVENTS_SCRIPT}}

  activity_feed:
    type: script
    from: decoded_events
    language: typescript
    primary_key: activity_id
    schema:
      activity_id: string
      deployment_id: string
      contract_id: string
      contract_role: string
      event_name: string
      topics: string
      args: string
      kind: string
      title: string
      summary: string
      visibility: string
      proposal_id: string
      token_id: string
      amount: string
      actor: string
      addresses: string
      ledger_sequence: int64
      transaction_index: int64
      operation_index: int64
      event_index: int64
      ledger_closed_at: string
      transaction_hash: string
    script: |
{{ACTIVITY_SCRIPT}}

  manager_daos:
    type: sql
    primary_key: event_id
    sql: |
      SELECT
        e.event_id,
        e.deployment_id,
        e.contract_id,
        e.contract_role,
        e.event_name,
        e.topic_0,
        e.topic_1,
        e.topic_2,
        e.topic_3,
        e.topics,
        e.args,
        e.transaction_hash,
        e.transaction_successful,
        e.ledger_sequence,
        e.ledger_hash,
        e.ledger_closed_at,
        e.transaction_index,
        e.operation_index,
        e.event_index,
        e.operation_type,
        e._gs_op,
        e.decoder_version,
        -- Extract manager.daos fields from DaoCreated/DaoRegistered events
        e.topic_0 AS dao_id,
        e.topic_0 AS token_address,
        e.topic_1 AS creator,
        e.contract_id AS manager_contract,
        CASE
          WHEN e.args::jsonb @> '{"modules":{}}'
          THEN (e.args::jsonb -> 'modules' ->> 'token')::text
          ELSE NULL
        END AS token_contract,
        CASE
          WHEN e.args::jsonb @> '{"modules":{}}'
          THEN (e.args::jsonb -> 'modules' ->> 'governor')::text
          ELSE NULL
        END AS governor_contract,
        CASE
          WHEN e.args::jsonb @> '{"modules":{}}'
          THEN (e.args::jsonb -> 'modules' ->> 'auction')::text
          ELSE NULL
        END AS auction_contract,
        CASE
          WHEN e.args::jsonb @> '{"modules":{}}'
          THEN (e.args::jsonb -> 'modules' ->> 'treasury')::text
          ELSE NULL
        END AS treasury_contract,
        CASE
          WHEN e.args::jsonb @> '{"modules":{}}'
          THEN (e.args::jsonb -> 'modules' ->> 'metadata')::text
          ELSE NULL
        END AS metadata_contract,
        -- Token metadata fields are not emitted in DaoCreated event
        -- These can be populated by querying the deployed token contract separately
        NULL::varchar(255) AS token_name,
        NULL::varchar(16) AS token_symbol,
        NULL::text AS token_description,
        NULL::text AS token_uri,
        NULL::varchar(56) AS admin_address,
        'pending'::text AS status,
        e.ledger_sequence AS created_ledger,
        to_timestamp(
          CASE
            WHEN e.ledger_closed_at IS NOT NULL AND e.ledger_closed_at != ''
            THEN NULLIF(e.ledger_closed_at, '')::numeric / 1000
            ELSE NULL
          END
        ) AS created_at,
        e.transaction_hash AS created_tx_hash,
        NULL::bigint AS finalized_ledger,
        NULL::timestamptz AS finalized_at,
        NULL::text AS finalized_tx_hash
      FROM decoded_events e
      WHERE e.contract_role = 'manager'
      AND LOWER(e.event_name) IN ('dao_created', 'daocreated', 'dao_registered', 'daoregistered')

  manager_daos_finalized:
    type: sql
    primary_key: event_id
    sql: |
      SELECT
        e.event_id,
        e.deployment_id,
        e.contract_id,
        e.contract_role,
        e.event_name,
        e.topic_0,
        e.topic_1,
        e.topic_2,
        e.topic_3,
        e.topics,
        e.args,
        e.transaction_hash,
        e.transaction_successful,
        e.ledger_sequence,
        e.ledger_hash,
        e.ledger_closed_at,
        e.transaction_index,
        e.operation_index,
        e.event_index,
        e.operation_type,
        e._gs_op,
        e.decoder_version,
        d.dao_id,
        d.token_address,
        d.creator,
        d.manager_contract,
        d.token_contract,
        d.governor_contract,
        d.auction_contract,
        d.treasury_contract,
        d.metadata_contract,
        d.token_name,
        d.token_symbol,
        d.token_description,
        d.token_uri,
        d.admin_address,
        'operational'::text AS status,
        d.created_ledger,
        d.created_at,
        d.created_tx_hash,
        e.ledger_sequence AS finalized_ledger,
        to_timestamp(
          CASE
            WHEN e.ledger_closed_at IS NOT NULL AND e.ledger_closed_at != ''
            THEN NULLIF(e.ledger_closed_at, '')::numeric / 1000
            ELSE NULL
          END
        ) AS finalized_at,
        e.transaction_hash AS finalized_tx_hash
      FROM decoded_events e
      JOIN manager_daos d
        ON d.deployment_id = e.deployment_id
       AND d.dao_id = e.topic_0
      WHERE e.contract_role = 'manager'
      AND LOWER(e.event_name) IN ('dao_finalized', 'daofinalized')

  manager_daos_enriched:
    type: sql
    primary_key: event_id
    sql: |
      SELECT
        e.event_id,
        e.deployment_id,
        -- Extract manager.daos enrichment from TokenInitialized events
        CASE
          WHEN e.args::jsonb @> '{"owner":""}'
          THEN (e.args::jsonb ->> 'owner')::text
          ELSE NULL
        END AS dao_id,
        e.contract_id AS token_contract,
        e.args ->> 'name' AS token_name,
        e.args ->> 'symbol' AS token_symbol,
        e.args ->> 'uri' AS token_uri,
        NULL::text AS token_description,
        NULL::varchar(56) AS admin_address
      FROM decoded_events e
      WHERE e.contract_role = 'token'
      AND LOWER(e.event_name) IN ('tokeninitialized', 'token_initialized')
      AND e.args IS NOT NULL

sinks:
  raw_events_output:
    type: postgres
    from: raw_events
    schema: chain
    table: raw_events
    secret_name: {{POSTGRES_SECRET_NAME}}
    primary_key: event_id

  decoded_events_output:
    type: postgres
    from: decoded_events
    schema: chain
    table: decoded_events
    secret_name: {{POSTGRES_SECRET_NAME}}
    primary_key: event_id

  activity_feed_output:
    type: postgres
    from: activity_feed
    schema: app
    table: activity_feed_events
    secret_name: {{POSTGRES_SECRET_NAME}}
    primary_key: activity_id

  manager_daos_output:
    type: postgres
    from: manager_daos
    schema: manager
    table: daos
    secret_name: {{POSTGRES_SECRET_NAME}}
    primary_key:
      - deployment_id
      - dao_id
    on_conflict: update

  manager_daos_finalized_output:
    type: postgres
    from: manager_daos_finalized
    schema: manager
    table: daos
    secret_name: {{POSTGRES_SECRET_NAME}}
    primary_key:
      - deployment_id
      - dao_id
    on_conflict: update

  manager_daos_enriched_output:
    type: postgres
    from: manager_daos_enriched
    schema: manager
    table: daos
    secret_name: {{POSTGRES_SECRET_NAME}}
    primary_key:
      - deployment_id
      - dao_id
    on_conflict: update
