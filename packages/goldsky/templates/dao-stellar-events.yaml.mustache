name: {{PIPELINE_NAME}}
description: {{DESCRIPTION}}
resource_size: {{RESOURCE_SIZE}}
use_dedicated_ip: false
job: false
sources:
  stellar_events:
    type: dataset
    dataset_name: {{DATASET_NAME}}
    version: 1.2.0
    start_at: {{START_AT}}

transforms:
  dao_events:
    type: sql
    primary_key: event_id
    sql: |
      SELECT
        id AS event_id,
        '{{DEPLOYMENT_ID}}' AS deployment_id,
        contract_id,
        CASE contract_id
{{CONTRACT_ROLE_CASES}}
          ELSE 'unknown'
        END AS contract_role,
        type,
        topics,
        data,
        in_successful_contract_call,
        transaction_hash,
        transaction_account,
        transaction_account_muxed,
        transaction_fee_account,
        transaction_fee_account_muxed,
        transaction_successful,
        transaction_index,
        operation_body,
        operation_result_code,
        operation_type,
        ledger_sequence,
        ledger_hash,
        ledger_closed_at,
        _gs_op
      FROM stellar_events
      WHERE contract_id IN (
{{CONTRACT_ID_LIST}}
      )

  raw_events:
    type: script
    from: dao_events
    language: typescript
    primary_key: event_id
    schema:
      event_id: string
      deployment_id: string
      contract_id: string
      contract_role: string
      topics: string
      data: string
      transaction_hash: string
      transaction_successful: boolean
      ledger_sequence: int64
      ledger_hash: string
      ledger_closed_at: string
      transaction_index: int64
      operation_index: int64
      event_index: int64
      operation_type: string
      _gs_op: string
    script: |
{{RAW_EVENTS_SCRIPT}}

  decoded_events:
    type: script
    from: raw_events
    language: typescript
    primary_key: event_id
    schema:
      event_id: string
      deployment_id: string
      contract_id: string
      contract_role: string
      event_name: string
      event_type: string
      payload: string
      proposal_id: string
      proposal_number: string
      actor: string
      amount: string
      token_id: string
      bidder: string
      minter: string
      owner: string
      from_address: string
      to_address: string
      changed_by: string
      cancelled_by: string
      executor: string
      governor: string
      treasury: string
      new_treasury: string
      new_governor: string
      old_treasury: string
      old_governor: string
      token_contract: string
      token_contract_id: string
      old_token_contract: string
      new_token_contract: string
      authority: string
      caller: string
      spender: string
      target: string
      function: string
      support: string
      reason: string
      state: string
      eta: string
      description: string
      snapshot_ledger: string
      vote_start_timestamp: string
      deadline_ledger: string
      action_count: string
      transaction_hash: string
      transaction_successful: boolean
      ledger_sequence: int64
      ledger_hash: string
      ledger_closed_at: string
      transaction_index: int64
      operation_index: int64
      event_index: int64
      operation_type: string
      _gs_op: string
    script: |
{{DECODED_EVENTS_SCRIPT}}

  activity_feed:
    type: script
    from: decoded_events
    language: typescript
    primary_key: activity_id
    schema:
      activity_id: string
      deployment_id: string
      contract_id: string
      contract_role: string
      kind: string
      title: string
      summary: string
      proposal_id: string
      proposal_number: string
      actor: string
      addresses: string
      ledger_sequence: int64
      timestamp: string
      transaction_hash: string
    script: |
{{ACTIVITY_SCRIPT}}

sinks:
  raw_events_output:
    type: postgres
    from: raw_events
    schema: chain
    table: raw_events
    secret_name: {{POSTGRES_SECRET_NAME}}
    primary_key: event_id

  decoded_events_output:
    type: postgres
    from: decoded_events
    schema: chain
    table: decoded_events
    secret_name: {{POSTGRES_SECRET_NAME}}
    primary_key: event_id

  activity_feed_output:
    type: postgres
    from: activity_feed
    schema: app
    table: activity_feed
    secret_name: {{POSTGRES_SECRET_NAME}}
    primary_key: activity_id
