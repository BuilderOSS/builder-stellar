name: {{PIPELINE_NAME}}
description: {{DESCRIPTION}}
resource_size: {{RESOURCE_SIZE}}
use_dedicated_ip: false
job: false
sources:
  stellar_events:
    type: dataset
    dataset_name: {{DATASET_NAME}}
    version: 1.2.0
    start_at: {{START_AT}}

transforms:
  dao_events:
    type: sql
    primary_key: event_id
    sql: |
      SELECT
        id AS event_id,
        '{{DEPLOYMENT_ID}}' AS deployment_id,
        contract_id,
        CASE WHEN contract_id = '{{MANAGER_CONTRACT_ID}}' THEN 'manager' ELSE 'unknown' END AS contract_role,
        type,
        topics,
        data,
        in_successful_contract_call,
        transaction_hash,
        transaction_account,
        transaction_account_muxed,
        transaction_fee_account,
        transaction_fee_account_muxed,
        transaction_successful,
        transaction_index,
        operation_body,
        operation_result_code,
        operation_type,
        ledger_sequence,
        ledger_hash,
        ledger_closed_at,
        _gs_op
      FROM stellar_events
       WHERE ledger_sequence >= {{START_AT}}

  raw_events:
    type: script
    from: dao_events
    language: typescript
    primary_key: event_id
    schema:
      event_id: string
      deployment_id: string
      contract_id: string
      contract_role: string
      topics: string
      data: string
      transaction_hash: string
      transaction_successful: boolean
      ledger_sequence: int64
      ledger_hash: string
      ledger_closed_at: string
      transaction_index: int64
      operation_index: int64
      event_index: int64
      operation_type: string
      _gs_op: string
    script: |
{{RAW_EVENTS_SCRIPT}}

  decoded_events:
    type: script
    from: raw_events
    language: typescript
    primary_key: event_id
    schema:
      event_id: string
      deployment_id: string
      contract_id: string
      contract_role: string
      event_name: string
      topic_0: string
      topic_1: string
      topic_2: string
      topic_3: string
      topics: string
      args: string
      transaction_hash: string
      transaction_successful: boolean
      ledger_sequence: int64
      ledger_hash: string
      ledger_closed_at: string
      transaction_index: int64
      operation_index: int64
      event_index: int64
      operation_type: string
      _gs_op: string
      decoder_version: string
    script: |
{{DECODED_EVENTS_SCRIPT}}

  activity_feed:
    type: script
    from: decoded_events
    language: typescript
    primary_key: activity_id
    schema:
      activity_id: string
      deployment_id: string
      contract_id: string
      contract_role: string
      event_name: string
      topics: string
      args: string
      kind: string
      title: string
      summary: string
      visibility: string
      proposal_id: string
      token_id: string
      amount: string
      actor: string
      addresses: string
      ledger_sequence: int64
      transaction_index: int64
      operation_index: int64
      event_index: int64
      ledger_closed_at: string
      transaction_hash: string
    script: |
{{ACTIVITY_SCRIPT}}

  decoded_events_with_jsonb:
    type: sql
    from: decoded_events
    sql: |
      SELECT
        event_id,
        deployment_id,
        contract_id,
        contract_role,
        event_name,
        topic_0,
        topic_1,
        topic_2,
        topic_3,
        topics::jsonb as topics,
        args::jsonb as args,
        transaction_hash,
        transaction_successful,
        ledger_sequence,
        ledger_hash,
        ledger_closed_at,
        transaction_index,
        operation_index,
        event_index,
        operation_type,
        _gs_op,
        decoder_version
      FROM decoded_events

  activity_feed_with_jsonb:
    type: sql
    from: activity_feed
    sql: |
      SELECT
        activity_id,
        deployment_id,
        contract_id,
        contract_role,
        event_name,
        topics::jsonb as topics,
        args::jsonb as args,
        kind,
        title,
        summary,
        visibility,
        proposal_id,
        token_id,
        amount,
        actor,
        addresses::jsonb as addresses,
        ledger_sequence,
        transaction_index,
        operation_index,
        event_index,
        ledger_closed_at,
        transaction_hash
      FROM activity_feed

sinks:
  raw_events_output:
    type: postgres
    from: raw_events
    schema: chain
    table: raw_events
    secret_name: {{POSTGRES_SECRET_NAME}}
    primary_key: event_id

  decoded_events_output:
    type: postgres
    from: decoded_events_with_jsonb
    schema: chain
    table: decoded_events
    secret_name: {{POSTGRES_SECRET_NAME}}
    primary_key: event_id

  activity_feed_output:
    type: postgres
    from: activity_feed_with_jsonb
    schema: app
    table: activity_feed_events
    secret_name: {{POSTGRES_SECRET_NAME}}
    primary_key: activity_id
