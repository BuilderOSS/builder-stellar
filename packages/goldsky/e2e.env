# The walkthrough suite's own pipeline (docs/plans/walkthroughs-and-docs.md decision E1,
# runbook docs/qa/WALKTHROUGHS.md). It indexes the e2e Manager only, under its own deployment id,
# into its own database, so walkthrough tribes never appear on the public testnet app.
#   GOLDSKY_ENV_FILE=e2e.env pnpm generate
#   GOLDSKY_ENV_FILE=e2e.env ./scripts/deploy.sh deploy
# No credentials here: the secret is created once in Goldsky (goldsky secret create).
MANAGER_DEPLOYMENT_FILE=deploys/e2e-walk-testnet-manager.json
GOLDSKY_PIPELINE_NAME=builder-stellar-testnet-e2e
GOLDSKY_PIPELINE_FILE=pipelines/builder-stellar-e2e-events.yaml
GOLDSKY_POSTGRES_SECRET=BUILDER_E2E_POSTGRES_SECRET
