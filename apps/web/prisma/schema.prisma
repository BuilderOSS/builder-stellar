  @@map("proposal_detail")
  @@schema("app")
}

view GovernanceProposalVote {
  voteEventId      String    @map("vote_event_id")
  deploymentId     String    @map("deployment_id")
  daoId            String    @map("dao_id")
  contractId       String    @map("contract_id")
  proposalId       String    @map("proposal_id")
  voter            String
  support          Int
  weight           Decimal
  reason           String?
  eventLedger      BigInt    @map("event_ledger")
  transactionIndex BigInt?   @map("transaction_index")
  operationIndex   BigInt?   @map("operation_index")
  eventIndex       BigInt?   @map("event_index")
  eventAt          DateTime? @map("event_at")
  transactionHash  String    @map("transaction_hash")

  @@map("proposal_votes")
  @@schema("governance")
}

view GovernanceProposalComment {
  commentEventId   String    @map("comment_event_id")
  deploymentId     String    @map("deployment_id")
  daoId            String    @map("dao_id")
  contractId       String    @map("contract_id")
  proposalId       String    @map("proposal_id")
  author           String
  body             String
  eventLedger      BigInt    @map("event_ledger")
  transactionIndex BigInt?   @map("transaction_index")
  operationIndex   BigInt?   @map("operation_index")
  eventIndex       BigInt?   @map("event_index")
  eventAt          DateTime? @map("event_at")
  transactionHash  String    @map("transaction_hash")

  @@map("proposal_comments")
  @@schema("governance")
}

view TokenInventory {
  eventId         String    @map("event_id")
  deploymentId    String    @map("deployment_id")
  daoId           String    @map("dao_id")
  contractId      String    @map("contract_id")
  tokenId         BigInt    @map("token_id")
  owner           String
  eventLedger     BigInt    @map("event_ledger")
  eventAt         DateTime? @map("event_at")
  transactionHash String    @map("transaction_hash")

  @@map("inventory")
  @@schema("token")
}

view TokenMember {
  deploymentId       String  @map("deployment_id")
  daoId              String  @map("dao_id")
  contractId         String  @map("contract_id")
  address            String
  ownedTokenCount    BigInt  @map("owned_token_count")
  delegatedTo        String? @map("delegated_to")
  votingPower        BigInt  @map("voting_power")
  lastActivityLedger BigInt? @map("last_activity_ledger")

  @@map("members")
  @@schema("token")
}

view TokenMintAuthority {
  deploymentId String  @map("deployment_id")
  daoId        String  @map("dao_id")
  contractId   String  @map("contract_id")
  authority    String
  enabled      Boolean
  eventLedger  BigInt  @map("event_ledger")

  @@map("mint_authorities")
  @@schema("token")
}

view AuctionAuction {
  eventId               String    @map("event_id")
  deploymentId          String    @map("deployment_id")
  daoId                 String    @map("dao_id")
  contractId            String    @map("contract_id")
  tokenId               BigInt    @map("token_id")
  startSeconds          BigInt    @map("start_seconds")
  endSeconds            BigInt    @map("end_seconds")
  durationSeconds       BigInt?   @map("duration_seconds")
  reservePrice          Decimal   @map("reserve_price")
  paymentToken          String?   @map("payment_token")
  /** The latest bid is the highest and carries the current end (bids only grow, ends only extend). */
  highestBidder         String?   @map("highest_bidder")
  highestBid            Decimal?  @map("highest_bid")
  currentEndSeconds     BigInt    @map("current_end_seconds")
  extensionCount        Int       @map("extension_count")
  settled               Boolean
  cancelled             Boolean
  /** Settlement outcome: winner NULL when unsold; settledAmount 0 then. */
  winner                String?
  settledAmount         Decimal?  @map("settled_amount")
  closedAt              DateTime? @map("closed_at")
  closedTransactionHash String?   @map("closed_transaction_hash")
  createdLedger         BigInt    @map("created_ledger")
  transactionHash       String    @map("transaction_hash")

  @@map("auctions")
  @@schema("auction")
}

/// The newest auction per auction contract (the one that can be live).
view AuctionCurrentAuction {
  eventId               String    @map("event_id")
  deploymentId          String    @map("deployment_id")
  daoId                 String    @map("dao_id")
  contractId            String    @map("contract_id")
  tokenId               BigInt    @map("token_id")
  startSeconds          BigInt    @map("start_seconds")
  endSeconds            BigInt    @map("end_seconds")
  durationSeconds       BigInt?   @map("duration_seconds")
  reservePrice          Decimal   @map("reserve_price")
  paymentToken          String?   @map("payment_token")
  /** The latest bid is the highest and carries the current end (bids only grow, ends only extend). */
  highestBidder         String?   @map("highest_bidder")
  highestBid            Decimal?  @map("highest_bid")
  currentEndSeconds     BigInt    @map("current_end_seconds")
  extensionCount        Int       @map("extension_count")
  settled               Boolean
  cancelled             Boolean
  /** Settlement outcome: winner NULL when unsold; settledAmount 0 then. */
  winner                String?
  settledAmount         Decimal?  @map("settled_amount")
  closedAt              DateTime? @map("closed_at")
  closedTransactionHash String?   @map("closed_transaction_hash")
  createdLedger         BigInt    @map("created_ledger")
  transactionHash       String    @map("transaction_hash")

  @@map("current_auctions")
  @@schema("auction")
}

view AuctionBid {
  eventId         String    @map("event_id")
  deploymentId    String    @map("deployment_id")
  daoId           String    @map("dao_id")
  contractId      String    @map("contract_id")
  tokenId         BigInt    @map("token_id")
  bidder          String
  amount          Decimal
  extended        Boolean?
  newEndSeconds   BigInt?   @map("new_end_seconds")
  eventLedger     BigInt    @map("event_ledger")
  eventAt         DateTime? @map("event_at")
  transactionHash String    @map("transaction_hash")
  comment         String?

  @@map("bids")
  @@schema("auction")
}

/// Slugs a DAO moved away from by vote (Manager change_slug). Not reserved: another DAO may hold one now.
view ManagerDaoPreviousSlug {
  deploymentId     String    @map("deployment_id")
  daoId            String    @map("dao_id")
  slug             String
  ledgerSequence   BigInt    @map("ledger_sequence")
  transactionIndex BigInt?   @map("transaction_index")
  operationIndex   BigInt?   @map("operation_index")
  eventIndex       BigInt?   @map("event_index")
  changedAt        DateTime? @map("changed_at")

  @@map("dao_previous_slugs")
  @@schema("manager")
}

view TokenSupply {
  deploymentId     String @map("deployment_id")
  daoId            String @map("dao_id")
  contractId       String @map("contract_id")
  mintedSupply     BigInt @map("minted_supply")
  systemHeldSupply BigInt @map("system_held_supply")
  votingSupply     BigInt @map("voting_supply")

  @@map("supply")
  @@schema("token")
}

view GovernanceSettings {
  deploymentId        String    @map("deployment_id")
  daoId               String    @map("dao_id")
  governorContract    String    @map("governor_contract")
  admin               String?
  votingDelaySeconds  BigInt?   @map("voting_delay_seconds")
  votingPeriodSeconds BigInt?   @map("voting_period_seconds")
  queueDelaySeconds   BigInt?   @map("queue_delay_seconds")
  proposalThreshold   Decimal?  @map("proposal_threshold")
  quorumBps           Int?      @map("quorum_bps")
  initLedger          BigInt    @map("init_ledger")
  initAt              DateTime? @map("init_at")
  updatedLedger       BigInt?   @map("updated_ledger")

  @@map("settings")
  @@schema("governance")
}

view ManagerDaoModule {
  deploymentId    String  @map("deployment_id")
  daoId           String  @map("dao_id")
  /** The pipeline role: token, metadata, governor, treasury, a known kind, or module. */
  moduleRole      String  @map("module_role")
  /** The registry kind as registered (custom_<name> for an external module). */
  kind            String
  moduleContract  String  @map("module_contract")
  createdWasmHash String? @map("created_wasm_hash")
  nonVoting       Boolean @map("non_voting")
  registered      Boolean

  @@map("dao_modules")
  @@schema("manager")
}

view ManagerAssuranceDrive {
  deploymentId      String    @map("deployment_id")
  daoId             String    @map("dao_id")
  claimMinter       String    @map("claim_minter")
  listId            BigInt    @map("list_id")
  deadline          Decimal
  launchAuction     Boolean   @map("launch_auction")
  launchMarketplace Boolean   @map("launch_marketplace")
  openedLedger      BigInt    @map("opened_ledger")
  openedAt          DateTime? @map("opened_at")
  /** open, launched or released (failed: the slug is free again). */
  outcome           String
  releasedAt        DateTime? @map("released_at")

  @@map("assurance_drives")
  @@schema("manager")
}

view TokenSettings {
  deploymentId          String  @map("deployment_id")
  daoId                 String  @map("dao_id")
  contractId            String  @map("contract_id")
  transfersLocked       Boolean @map("transfers_locked")
  membersOnlyDelegation Boolean @map("members_only_delegation")
  daoRecovery           Boolean @map("dao_recovery")
  lastChangedLedger     BigInt? @map("last_changed_ledger")

  @@map("settings")
  @@schema("token")
}

view TokenTransferAgent {
  deploymentId String  @map("deployment_id")
  daoId        String  @map("dao_id")
  contractId   String  @map("contract_id")
  module       String
  changedBy    String? @map("changed_by")
  eventLedger  BigInt  @map("event_ledger")

  @@map("transfer_agents")
  @@schema("token")
}

/** Delegate picker rows; isMember is the members-only rule (holds a token). */
view TokenDelegate {
  deploymentId    String  @map("deployment_id")
  daoId           String  @map("dao_id")
  contractId      String  @map("contract_id")
  address         String
  votingPower     BigInt  @map("voting_power")
  delegatorCount  BigInt  @map("delegator_count")
  ownedTokenCount BigInt  @map("owned_token_count")
  /** The Treasury or a non-voting module: holds tokens but is never a member. */
  custody         Boolean
  isMember        Boolean @map("is_member")

  @@map("delegates")
  @@schema("token")
}

view TokenManagedTransfer {
  eventId         String    @map("event_id")
  deploymentId    String    @map("deployment_id")
  daoId           String    @map("dao_id")
  contractId      String    @map("contract_id")
  /** dao (a proposal moved it) or agent (a transfer agent moved it with the holder's signature). */
  transferKind    String    @map("transfer_kind")
  tokenId         BigInt    @map("token_id")
  fromAddress     String    @map("from_address")
  toAddress       String    @map("to_address")
  movedBy         String?   @map("moved_by")
  eventLedger     BigInt    @map("event_ledger")
  eventAt         DateTime? @map("event_at")
  transactionHash String    @map("transaction_hash")

  @@map("managed_transfers")
  @@schema("token")
}

