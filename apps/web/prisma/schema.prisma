view MinterAllowlistClaimEvent {
  eventId          String    @map("event_id")
  deploymentId     String    @map("deployment_id")
  daoId            String    @map("dao_id")
  contractId       String    @map("contract_id")
  tokenId          String    @map("token_id")
  recipient        String
  amount           Decimal
  ledgerSequence   BigInt    @map("ledger_sequence")
  transactionIndex BigInt?   @map("transaction_index")
  operationIndex   BigInt?   @map("operation_index")
  eventIndex       BigInt?   @map("event_index")
  eventAt          DateTime? @map("event_at")
  transactionHash  String    @map("transaction_hash")

  @@map("allowlist_claim_events")
  @@schema("minter")
}

view ManagerDaoSlug {
  deploymentId  String    @map("deployment_id")
  daoId         String    @map("dao_id")
  requestedSlug String?   @map("requested_slug")
  claimedSlug   String?   @map("claimed_slug")
  claimedLedger BigInt?   @map("claimed_ledger")
  claimedAt     DateTime? @map("claimed_at")

  @@map("dao_slugs")
  @@schema("manager")
}

view ManagerModuleAdmin {
  deploymentId     String    @map("deployment_id")
  daoId            String    @map("dao_id")
  moduleRole       String    @map("module_role")
  moduleContract   String    @map("module_contract")
  admin            String?
  handedToTreasury Boolean   @map("handed_to_treasury")
  changedLedger    BigInt?   @map("changed_ledger")
  changedAt        DateTime? @map("changed_at")
  changedTxHash    String?   @map("changed_tx_hash")

  @@map("module_admins")
  @@schema("manager")
}

view TokenSupply {
  deploymentId     String @map("deployment_id")
  daoId            String @map("dao_id")
  contractId       String @map("contract_id")
  mintedSupply     BigInt @map("minted_supply")
  systemHeldSupply BigInt @map("system_held_supply")
  votingSupply     BigInt @map("voting_supply")

  @@map("supply")
  @@schema("token")
}

view GovernanceSettings {
  deploymentId        String    @map("deployment_id")
  daoId               String    @map("dao_id")
  governorContract    String    @map("governor_contract")
  admin               String?
  votingDelaySeconds  BigInt?   @map("voting_delay_seconds")
  votingPeriodSeconds BigInt?   @map("voting_period_seconds")
  queueDelaySeconds   BigInt?   @map("queue_delay_seconds")
  proposalThreshold   Decimal?  @map("proposal_threshold")
  quorumBps           Int?      @map("quorum_bps")
  version             String?
  initLedger          BigInt    @map("init_ledger")
  initAt              DateTime? @map("init_at")
  updatedLedger       BigInt?   @map("updated_ledger")

  @@map("settings")
  @@schema("governance")
}
