generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("APP_DATABASE_URL")
  schemas  = ["app", "auction", "claims", "governance", "manager", "marketplace", "metadata", "token"]
}

view ManagerDao {
  deploymentId        String    @map("deployment_id")
  daoId               String    @map("dao_id")
  /** Claimed slug once launched, else the latest request (not unique among pending DAOs). */
  slug                String?
  slugClaimed         Boolean   @map("slug_claimed")
  requestedSlug       String?   @map("requested_slug")
  claimedSlug         String?   @map("claimed_slug")
  tokenAddress        String    @map("token_address")
  deployer            String?
  launchAdmin         String?   @map("launch_admin")
  managerContract     String    @map("manager_contract")
  tokenContract       String    @map("token_contract")
  governorContract    String    @map("governor_contract")
  /** The registered Auction, Marketplace and ClaimMinter; null for a kind the DAO does not have. */
  auctionContract     String?   @map("auction_contract")
  treasuryContract    String?   @map("treasury_contract")
  metadataContract    String?   @map("metadata_contract")
  marketplaceContract String?   @map("marketplace_contract")
  claimsContract      String?   @map("claims_contract")
  tokenName           String?   @map("token_name")
  tokenSymbol         String?   @map("token_symbol")
  /** Latest ProfileUpdated JSON, byte-for-byte; verify against metadata.profile_hash() before use. */
  profile             String?
  profileHash         String?   @map("profile_hash")
  profileSeq          BigInt?   @map("profile_seq")
  /** Current admin: the launch admin during setup, the Treasury (a contract) after launch. */
  adminAddress        String?   @map("admin_address")
  status              String
  /** An assurance drive's outcome: open, launched or released (failed); null without one. */
  assuranceOutcome    String?   @map("assurance_outcome")
  auctionEnabled      Boolean?  @map("auction_enabled")
  marketplaceEnabled  Boolean?  @map("marketplace_enabled")
  auctionPaused       Boolean?  @map("auction_paused")
  createdLedger       BigInt    @map("created_ledger")
  createdAt           DateTime? @map("created_at")
  createdTxHash       String?   @map("created_tx_hash")
  launchedLedger      BigInt?   @map("launched_ledger")
  launchedAt          DateTime? @map("launched_at")
  launchedTxHash      String?   @map("launched_tx_hash")
  indexedAt           DateTime? @map("indexed_at")

  @@map("daos")
  @@schema("manager")
}

// Read-only mappings of views in db/migrations. Never migrate these models.
view MarketplaceModuleLaunch {
  deploymentId   String   @map("deployment_id")
  daoId          String   @map("dao_id")
  moduleRole     String   @map("module_role")
  moduleContract String   @map("module_contract")
  isLive         Boolean  @map("is_live")
  opened         Boolean?
  treasury       String?

  @@map("module_launches")
  @@schema("manager")
}

view MarketplacePool {
  eventId               String    @map("event_id")
  deploymentId          String    @map("deployment_id")
  daoId                 String    @map("dao_id")
  contractId            String    @map("contract_id")
  poolId                BigInt    @map("pool_id")
  price                 Decimal   @db.Decimal(78, 0)
  asset                 String
  expiresAt             BigInt    @map("expires_at")
  size                  BigInt
  maxPerBuyer           BigInt    @map("max_per_buyer")
  maxSoldPerPeriod      BigInt    @map("max_sold_per_period")
  periodSecs            BigInt    @map("period_secs")
  stocked               BigInt
  sold                  BigInt
  swept                 BigInt
  inStock               BigInt    @map("in_stock")
  /** open or closed; an expired pool stays open until closed: compare expiresAt. */
  status                String
  released              BigInt?
  openedLedger          BigInt    @map("opened_ledger")
  openedAt              DateTime? @map("opened_at")
  openedTransactionHash String    @map("opened_transaction_hash")
  closedLedger          BigInt?   @map("closed_ledger")
  closedAt              DateTime? @map("closed_at")

  @@map("pools")
  @@schema("marketplace")
}

/** Token ids a pool still holds; the stock page is read on chain before buying. */
view MarketplacePoolStock {
  deploymentId    String @map("deployment_id")
  daoId           String @map("dao_id")
  contractId      String @map("contract_id")
  poolId          BigInt @map("pool_id")
  tokenId         BigInt @map("token_id")
  restockedLedger BigInt @map("restocked_ledger")

  @@map("pool_stock")
  @@schema("marketplace")
}

view MarketplaceSecondaryListing {
  eventId                String    @map("event_id")
  deploymentId           String    @map("deployment_id")
  daoId                  String    @map("dao_id")
  contractId             String    @map("contract_id")
  tokenId                BigInt    @map("token_id")
  seller                 String
  price                  Decimal   @db.Decimal(78, 0)
  expiresAt              BigInt    @map("expires_at")
  feeBps                 Int       @map("fee_bps")
  paymentAsset           String    @map("payment_asset")
  status                 String
  createdLedger          BigInt    @map("created_ledger")
  createdAt              DateTime? @map("created_at")
  createdTransactionHash String    @map("created_transaction_hash")
  closedLedger           BigInt?   @map("closed_ledger")
  closedAt               DateTime? @map("closed_at")
  closedTransactionHash  String?   @map("closed_transaction_hash")
  buyer                  String?

  @@map("secondary_listings")
  @@schema("marketplace")
}

view MarketplaceListingComment {
  commentEventId   String    @map("comment_event_id")
  deploymentId     String    @map("deployment_id")
  daoId            String    @map("dao_id")
  contractId       String    @map("contract_id")
  tokenId          BigInt    @map("token_id")
  author           String
  body             String
  eventLedger      BigInt    @map("event_ledger")
  transactionIndex BigInt?   @map("transaction_index")
  operationIndex   BigInt?   @map("operation_index")
  eventIndex       BigInt?   @map("event_index")
  eventAt          DateTime? @map("event_at")
  transactionHash  String    @map("transaction_hash")

  @@map("listing_comments")
  @@schema("marketplace")
}

view MarketplaceSale {
  eventId         String    @map("event_id")
  deploymentId    String    @map("deployment_id")
  daoId           String    @map("dao_id")
  contractId      String    @map("contract_id")
  /** pool (a quick-buy sale; poolId set) or secondary. */
  saleType        String    @map("sale_type")
  poolId          BigInt?   @map("pool_id")
  tokenId         BigInt    @map("token_id")
  buyer           String
  seller          String?
  price           Decimal   @db.Decimal(78, 0)
  fee             Decimal?  @db.Decimal(78, 0)
  paymentAsset    String    @map("payment_asset")
  eventLedger     BigInt    @map("event_ledger")
  eventAt         DateTime? @map("event_at")
  transactionHash String    @map("transaction_hash")

  @@map("sales")
  @@schema("marketplace")
}

view AppActivityFeed {
  activityId       String  @map("activity_id")
  deploymentId     String  @map("deployment_id")
  daoId            String? @map("dao_id")
  contractId       String  @map("contract_id")
  contractRole     String  @map("contract_role")
  eventName        String  @map("event_name")
  topics           String
  args             String
  kind             String
  title            String
  summary          String
  actor            String?
  addresses        String
  proposalId       String? @map("proposal_id")
  tokenId          String? @map("token_id")
  amount           String?
  visibility       String
  ledgerSequence   BigInt  @map("ledger_sequence")
  transactionIndex BigInt? @map("transaction_index")
  operationIndex   BigInt? @map("operation_index")
  eventIndex       BigInt? @map("event_index")
  ledgerClosedAt   String? @map("ledger_closed_at")
  transactionHash  String  @map("transaction_hash")

  @@map("activity_feed")
  @@schema("app")
}

/// Feed freshness from the index, for the health endpoint.
view AppFeedStatus {
  deploymentId  String @map("deployment_id")
  latestLedger  BigInt @map("latest_ledger")
  lastHourCount BigInt @map("last_hour_count")

  @@map("feed_status")
  @@schema("app")
}

view AppIndexerStatus {
  deploymentId   String   @map("deployment_id")
  latestLedger   BigInt   @map("latest_ledger")
  eventCount     BigInt   @map("event_count")
  lastIngestedAt DateTime @map("last_ingested_at")

  @@map("indexer_status")
  @@schema("app")
}

view AppProposalList {
  proposalNumber         Int       @map("proposal_number")
  createdEventId         String    @map("created_event_id")
  deploymentId           String    @map("deployment_id")
  daoId                  String    @map("dao_id")
  contractId             String    @map("contract_id")
  proposalId             String    @map("proposal_id")
  proposer               String
  description            String?
  snapshotLedger         BigInt?   @map("snapshot_ledger")
  voteStartSeconds       BigInt?   @map("vote_start_seconds")
  voteEndSeconds         BigInt?   @map("vote_end_seconds")
  quorumVotes            Decimal?  @map("quorum_votes")
  actionCount            Int       @map("action_count")
  createdLedger          BigInt    @map("created_ledger")
  transactionIndex       BigInt?   @map("transaction_index")
  operationIndex         BigInt?   @map("operation_index")
  eventIndex             BigInt?   @map("event_index")
  createdAt              DateTime? @map("created_at")
  createdTransactionHash String    @map("created_transaction_hash")
  state                  String
  etaSeconds             BigInt?   @map("eta_seconds")
  updatedLedger          BigInt?   @map("updated_ledger")
  updatedAt              DateTime? @map("updated_at")
  forVotes               Decimal   @map("for_votes")
  againstVotes           Decimal   @map("against_votes")
  abstainVotes           Decimal   @map("abstain_votes")

  @@map("proposal_list")
  @@schema("app")
}

view AppProposalDetail {
  proposalNumber         Int       @map("proposal_number")
  createdEventId         String    @map("created_event_id")
  deploymentId           String    @map("deployment_id")
  daoId                  String    @map("dao_id")
  contractId             String    @map("contract_id")
  proposalId             String    @map("proposal_id")
  proposer               String
  description            String?
  snapshotLedger         BigInt?   @map("snapshot_ledger")
  voteStartSeconds       BigInt?   @map("vote_start_seconds")
  voteEndSeconds         BigInt?   @map("vote_end_seconds")
  quorumVotes            Decimal?  @map("quorum_votes")
  actionCount            Int       @map("action_count")
  createdLedger          BigInt    @map("created_ledger")
  transactionIndex       BigInt?   @map("transaction_index")
  operationIndex         BigInt?   @map("operation_index")
  eventIndex             BigInt?   @map("event_index")
  createdAt              DateTime? @map("created_at")
  createdTransactionHash String    @map("created_transaction_hash")
  state                  String
  etaSeconds             BigInt?   @map("eta_seconds")
  updatedLedger          BigInt?   @map("updated_ledger")
  updatedAt              DateTime? @map("updated_at")
  forVotes               Decimal   @map("for_votes")
  againstVotes           Decimal   @map("against_votes")
  abstainVotes           Decimal   @map("abstain_votes")
