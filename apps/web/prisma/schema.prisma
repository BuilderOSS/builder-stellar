view ClaimsClaimer {
  deploymentId String  @map("deployment_id")
  daoId        String  @map("dao_id")
  contractId   String  @map("contract_id")
  listId       BigInt  @map("list_id")
  claimer      String
  claimed      BigInt
  paid         Decimal @db.Decimal(78, 0)
  escrowed     Decimal @db.Decimal(78, 0)
  refunded     Decimal @db.Decimal(78, 0)

  @@map("claimers")
  @@schema("claims")
}
