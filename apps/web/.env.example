# Network where this manager deployment is running
# Determines RPC URL, network passphrase, and other network-specific settings
# Options: testnet, public, local
NEXT_PUBLIC_NETWORK=testnet

# Read-only database connection for the web app's Prisma views
# PostgreSQL connection string with SSL enabled
# Format: postgres://user:password@host:port/database?sslmode=require
APP_DATABASE_URL=

# Public origin of the site, used for absolute metadata URLs (share images, canonical links).
# Defaults to https://tribes.build when unset.
NEXT_PUBLIC_SITE_URL=https://tribes.build

# Server-side origin used to bind wallet authentication challenges.
# Required in production. Local development falls back to the request origin.
APP_URL=http://localhost:4242

# Iron-session encryption secret. Use at least 32 characters and never expose it publicly.
# To rotate it, use a JSON map of numbered secrets, such as {"2":"<new>","1":"<old>"}: new
# cookies are sealed with the highest number, and cookies sealed with any listed number still
# open. Remove the old number after 24 hours (see docs/DEV_DEPLOYMENT.md).
IRON_PASSWORD=

# Optional secret for upload and pin tokens, at least 32 characters, so they can rotate apart from
# sessions. When unset, they use a key derived from the current IRON_PASSWORD.
UPLOAD_TOKEN_SECRET=

# Sign-in rate limits count per client address. On Vercel the app reads x-vercel-forwarded-for.
# Elsewhere it trusts no client-supplied header unless you name the one your proxy sets or
# overwrites (for example x-forwarded-for or cf-connecting-ip); it reads the last address in it.
# Name one only behind a proxy: bare `next start` passes on what the client sent. Behind two
# proxies that both append to x-forwarded-for, name a header the outer one overwrites instead.
# Without one, production sign-in requests are refused with 503. Local development needs none.
TRUSTED_CLIENT_IP_HEADER=

# WalletConnect Cloud project id. Required to show WalletConnect wallets, including Freighter Mobile.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Page Content-Security-Policy: report-only unless this is 'enforce' (docs/SECURITY_MODEL.md,
# "Response headers"). next.config.mjs reads it at build time and the middleware per request,
# so set it before a build and leave it unchanged while that build runs.
# CSP_MODE=enforce

# SEP-10 server authentication account and domain binding.
# The secret must belong to a funded account on the configured Stellar network.
STELLAR_WEB_AUTH_SECRET=
STELLAR_HOME_DOMAIN=localhost
STELLAR_WEB_AUTH_DOMAIN=localhost

# Optional display name used in the wallet signing prompt.
AUTH_APP_NAME=Tribe Builder

# Pinata Upload Configuration (optional, enables direct IPFS uploads)
# Set to 'true' to enable artwork directory uploads
# Used by: DaoImageField (client), /api/uploads/* (server)
NEXT_PUBLIC_PINATA_UPLOADS_ENABLED=false

# Pinata JWT for upload authorization
# Required when NEXT_PUBLIC_PINATA_UPLOADS_ENABLED=true
# Can be either:
#  - A standard JWT with pinFileToIPFS permission
#  - An API key that can generate restricted upload tokens
# Used by: /api/pinata/generate-jwt (server), /api/uploads/pinata-url (server)
# Server-side only, never expose publicly
PINATA_JWT=

# Preferred Pinata IPFS gateway host for resolver URLs
# Falls back to built-in gateway list if unavailable
# Available to both client and server (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_PINATA_GATEWAY=nouns-builder.mypinata.cloud

# Goldsky pipeline monitoring for GET /api/health (optional). With a Viewer-role API token the
# endpoint compares the pipeline's own position and status with the chain head; without one it
# reports the chain and database only. Server-side only, never expose publicly.
# The pipeline name defaults to builder-stellar-<NEXT_PUBLIC_NETWORK>.
GOLDSKY_API_TOKEN=
GOLDSKY_PIPELINE_NAME=

# Dev-only Agentation feedback toolbar (opt-in). Set to true in .env.local, then run
# `npx -y agentation-mcp server` (port 4747) and register it with your agent.
NEXT_PUBLIC_AGENTATION_ENABLED=false
