# Deployment Selection (required)
# Set these to match a deployment in deploys/*.json
# Example: deploys/builder-testnet.json would be network=testnet, label=builder
NEXT_PUBLIC_DAO_NETWORK=testnet
NEXT_PUBLIC_DAO_LABEL=builder

# Database Connection (required for Goldsky integration)
# Neon PostgreSQL connection string with SSL enabled
# Format: postgres://user:password@host:port/database?sslmode=require
APP_DATABASE_URL=

# Secrets (deprecated - will be removed)
MERCURY_JWT=
