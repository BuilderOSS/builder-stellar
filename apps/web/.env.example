# Multi-Tenant Configuration
# deployment_id identifies this app instance's manager contract
# ALL DAOs under this manager share the same deployment_id
# Format: manager:CONTRACT_ADDRESS
# Example: manager:CBSKIHNNVKEJWV3A2OI63BWUC637LR4P2GBV4MPJB5PDOMVUMS6KOMAH
NEXT_PUBLIC_DEPLOYMENT_ID=manager:YOUR_MANAGER_CONTRACT_ADDRESS_HERE

# Network where this manager deployment is running
# Determines RPC URL, network passphrase, and other network-specific settings
# Options: testnet, public, local
NEXT_PUBLIC_NETWORK=testnet

# Database Connection (required for Goldsky integration)
# Neon PostgreSQL connection string with SSL enabled
# Format: postgres://user:password@host:port/database?sslmode=require
APP_DATABASE_URL=

# Server-side origin used to bind wallet authentication challenges.
# Required in production. Local development falls back to the request origin.
APP_URL=http://localhost:3000

# Iron-session encryption secret. Use at least 32 characters and never expose it publicly.
IRON_PASSWORD=
