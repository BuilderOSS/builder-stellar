{
  "name": "@builder-stellar/web",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/generate-deployment-config.mjs && panda codegen && panda cssgen",
    "dev": "next dev",
    "prebuild": "pnpm --filter @builder-stellar/token-bindings --filter @builder-stellar/governor-bindings --filter @builder-stellar/treasury-bindings --filter @builder-stellar/auction-bindings build && node ../../scripts/generate-deployment-config.mjs && panda codegen && panda cssgen",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "panda:codegen": "panda codegen && panda cssgen"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.5.0",
    "@neondatabase/serverless": "^1.1.0",
    "@noble/hashes": "^2.2.0",
    "@builder-stellar/governor-bindings": "workspace:*",
    "@builder-stellar/auction-bindings": "workspace:*",
    "@builder-stellar/token-bindings": "workspace:*",
    "@builder-stellar/treasury-bindings": "workspace:*",
    "@stellar/stellar-sdk": "^17.0.1",
    "buffer": "^6.0.3",
    "next": "^15.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.5.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@ark-ui/react": "^5.37.2",
    "@pandacss/dev": "1.11.5",
    "@pandacss/preset-panda": "1.11.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "lucide-react": "^1.27.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0"
  }
}
