    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@playwright/test": "1.62.1",
    "@stellar/stellar-sdk": "^17.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
