{
  "name": "@builder-stellar/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "panda codegen && panda cssgen",
    "predev": "pnpm codegen",
    "dev": "next dev --port 4320",
    "prebuild": "pnpm codegen",
    "build": "next build && pagefind --site out",
    "search:dev": "pnpm build && rm -rf public/pagefind && cp -R out/pagefind public/pagefind",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:site": "node scripts/check-site.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "@builder-stellar/design-tokens": "workspace:*",
    "@builder-stellar/glossary": "workspace:*",
    "@builder-stellar/web": "workspace:*",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.4.0",
    "lucide-react": "^1.27.0",
    "next": "^15.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@pandacss/dev": "1.11.5",
    "@pandacss/preset-panda": "1.11.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "1.4.0",
    "playwright-core": "1.57.0",
    "prettier": "^3.9.6",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "typescript": "^5.8.0",
    "unified": "^11.0.5",
    "vitest": "^3.2.4"
  }
}
