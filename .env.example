# Current web default (legacy single-DAO selection; multi-DAO migration pending)
NEXT_PUBLIC_DAO_NETWORK=testnet
NEXT_PUBLIC_DAO_LABEL=builder

# Goldsky Manager deployment artifact
MANAGER_DEPLOYMENT_FILE=deploys/builder-testnet-manager.json

# Database Connection (required for Goldsky integration)
